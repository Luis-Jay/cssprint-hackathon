# Google Gemini (free key: https://aistudio.google.com/apikey)
# Free-tier inputs may be used by Google to improve its products - demo with
# sample IDs, not real customers' documents.
GEMINI_API_KEY=your_gemini_api_key_here
# Flash-Lite is fast and rarely overloaded; full Flash is tried when it is busy.
GEMINI_MODEL_ID=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL_ID=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=25
# Blank uses the model's default. Flash-Lite rejects 0.
GEMINI_THINKING_BUDGET=

# Model Parameters
MAX_TOKENS=2048
TEMPERATURE=0.0

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT="Sellyo"

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Reload restarts the process on every code change, which re-pays the ~7s
# RAG model load. Turn it off when measuring latency or running in prod.
BACKEND_RELOAD=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# RAG Configuration
VECTOR_DB_PATH=./rag/vector_db
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=3
USE_RERANKING=false

# Search model, run locally. Reads English, Filipino and Taglish.
# Changing it REQUIRES a rebuild: uv run python -m rag.reindex
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Embedding model cache.
# HF_HUB_OFFLINE=1 skips the HuggingFace Hub round trip on every model load
# (set it once the search model is cached locally - it is a hard requirement
# for predictable startup, and removes the unauthenticated-rate-limit warning).
HF_HOME=./.hf_cache
SENTENCE_TRANSFORMERS_HOME=./.hf_cache
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Photographed IDs and scanned PDFs are read locally with Tesseract. Install
# it with `brew install tesseract` or `apt install tesseract-ocr`.

# Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_TOKENS_PER_REQUEST=2048

# Logging
LOG_LEVEL=INFO
